# Shell scripts and the init banner run on Linux, so they are always stored and
# checked out with LF.
*.sh text eol=lf
.github/assets/banner-raw.txt text eol=lf

# Everything under rootfs/ ships into the Linux image: extensionless s6 service
# scripts (run), envsubst templates (*.tmpl) and configs. No binaries live here
# (checked), so the whole tree is pinned to LF and a CRLF checkout cannot break
# a shebang.
rootfs/** text eol=lf

# Generated banner assets: the generator writes LF, so pin them. Otherwise a fresh
# CRLF checkout makes every generator run report unchanged files as modified.
.github/assets/*.svg text eol=lf
