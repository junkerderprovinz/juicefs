#!/command/with-contenv sh
# shellcheck shell=sh
# Prints the "JUICEFS IS READY" block once the gateway answers, so the first
# start has a visible end. It also says where a generated secret key is, since a
# user who left that field empty has no other way of knowing one exists.
FLAG=/run/juicefs-ready.printed

# /run is a tmpfs, so the banner prints once per container start.
if [ -f "$FLAG" ]; then
    exec sleep infinity
fi

ready=0
i=0
while [ "$i" -lt 150 ]; do
    # An unauthenticated GET gets 403, which still proves the listener is up
    # but counts as a failure for curl -f.
    code="$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:9000 2>/dev/null)"
    case "$code" in
        200|403) ready=1; break ;;
    esac
    i=$((i + 1))
    sleep 2
done

/usr/local/bin/print-banner.sh "JuiceFS" "S3 gateway over a database and an object store, plug-and-play for Unraid"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$ready" -eq 1 ]; then
    printf '%b\n' "  ${GREEN}✓ JUICEFS IS READY${NC} - the S3 gateway is serving on port 9000"
    # 10-config.sh leaves the marker only when the key in the file is in use.
    if [ -f /run/key_generated ]; then
        printf '%b\n' "  ${YELLOW}! SECRET KEY WAS GENERATED${NC} - it is in /config/.s3_root_password, set the template field to choose your own"
    fi
else
    printf '%b\n' "  ${RED}✗ JUICEFS DID NOT BECOME READY${NC} - port 9000 never answered within 5 min, check the log above"
fi
echo ""

: > "$FLAG"
# A longrun that exits would be restarted by s6 and print the banner again.
exec sleep infinity
