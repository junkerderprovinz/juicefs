#!/command/with-contenv sh
# shellcheck shell=sh
# =============================================================================
# juicefs-ready — print a "JUICEFS IS READY" block to the container log once the
# gateway answers, so the first start has a visible end. House standard: every
# own-image container prints an "<APP> IS READY" log banner as the final block.
#
# It also prints where to find the generated secret key, because a user who
# left that field empty otherwise has no way of knowing one exists.
# =============================================================================
FLAG=/run/juicefs-ready.printed

# /run is tmpfs (wiped on every container start) -> the banner prints once/start.
if [ -f "$FLAG" ]; then
    exec sleep infinity
fi

ready=0
i=0
while [ "$i" -lt 150 ]; do
    # The gateway answers S3 requests; an unauthenticated GET on the root is
    # refused with 403, which still proves the listener is up. curl -f treats
    # 403 as failure, so match on the status code instead.
    code="$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:9000 2>/dev/null)"
    case "$code" in
        200|403) ready=1; break ;;
    esac
    i=$((i + 1))
    sleep 2
done

/usr/local/bin/print-banner.sh "JuiceFS" "S3 gateway over a database and an object store, plug-and-play for Unraid"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$ready" -eq 1 ]; then
    printf '%b\n' "  ${GREEN}✓ JUICEFS IS READY${NC} - the S3 gateway is serving on port 9000"
    if [ -f /config/.s3_root_password ]; then
        printf '%b\n' "  ${YELLOW}! SECRET KEY WAS GENERATED${NC} - it is in /config/.s3_root_password, set the template field to choose your own"
    fi
else
    printf '%b\n' "  ${RED}✗ JUICEFS DID NOT BECOME READY${NC} - port 9000 never answered within 5 min, check the log above"
fi
echo ""

: > "$FLAG"
# Longrun: stay up so s6 does not restart us and re-print the banner.
exec sleep infinity
