#!/command/with-contenv sh
# shellcheck shell=sh
# Runs the JuiceFS S3 gateway. The gateway needs no FUSE, no --privileged and
# no shared bind propagation, just a port; the mount mode would need all three,
# which does not fit a template a stranger installs with two clicks.
#
# JuiceFS reads the gateway credentials from MINIO_ROOT_USER and
# MINIO_ROOT_PASSWORD because its S3 layer is built on MinIO's gateway code.
# 10-config.sh has written the effective values to /run, supplied or generated.

PUID="${PUID:-99}"
PGID="${PGID:-100}"

MINIO_ROOT_USER="$(cat /run/s3_root_user)"
MINIO_ROOT_PASSWORD="$(cat /run/s3_root_password)"
META_URL="$(cat /run/meta_url)"
export MINIO_ROOT_USER MINIO_ROOT_PASSWORD

# Without an explicit cache directory JuiceFS derives one from HOME, and gosu
# drops to a uid without a passwd entry, so the cache would land in the
# unwritable /.juicefs/cache, clamped to zero with a warning per second in the
# log. gosu resets HOME, so the directory is passed as an argument instead.
CACHE_DIR="${CACHE_DIR:-/cache}"
mkdir -p "${CACHE_DIR}" 2>/dev/null
chown "${PUID}:${PGID}" "${CACHE_DIR}" 2>/dev/null

# A positional list rather than one string, so a path with a space stays one
# argument and a "*" is not expanded against the working directory.
set -- gateway

# Several buckets, on by default. Without the flag the file system is a single
# bucket named after the volume and CreateBucket is refused, while nearly every
# backup client creates its own bucket first (rclone's `mkdir` fails with
# NoSuchBucket). false restores upstream's single-bucket behaviour.
#
# Compared case-insensitively, since "True" means yes to anyone filling in a
# template field. Anything that is not a yes turns the flag off.
case "$(printf '%s' "${MULTI_BUCKETS:-true}" | tr '[:upper:]' '[:lower:]')" in
    true|yes|1|on) set -- "$@" --multi-buckets ;;
esac

# Optional tuning, all off unless the template sets them.
[ -n "${CACHE_SIZE}" ] && set -- "$@" --cache-size "${CACHE_SIZE}"
[ -n "${CACHE_DIR}" ]  && set -- "$@" --cache-dir  "${CACHE_DIR}"

# EXTRA_ARGS is a free-text field holding several arguments, so it is split on
# spaces, with globbing turned off first.
if [ -n "${EXTRA_ARGS}" ]; then
    set -f
    # shellcheck disable=SC2086
    set -- "$@" ${EXTRA_ARGS}
    set +f
fi

set -- "$@" "${META_URL}" 0.0.0.0:9000

cd /data || { echo "[juicefs] FATAL: cannot cd into /data" >&2; exit 1; }

exec gosu "${PUID}:${PGID}" /usr/local/bin/juicefs "$@"
